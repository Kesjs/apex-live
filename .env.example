# "supabase" (défaut en production) = lecture directe de Supabase. "api" = back-end local backend/. "demo" = données fictives.
VITE_DATA_SOURCE=supabase
# Utilisé seulement si VITE_DATA_SOURCE=api. Sans slash final.
VITE_API_URL=http://localhost:8787

# Connexion facultative (Supabase Auth). Sans ces deux valeurs, Apex marche sans compte.
# La clé « anon » / publishable est publique : elle peut être dans le front. Jamais la clé service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Complément gratuit football-data.co.uk (cartons, corners, fautes, cotes). Mets « non » pour le désactiver.
STATS_CSV=oui
