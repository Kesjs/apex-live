# Base de données (fichier SQLite créé automatiquement)
APEX_DB=apex.db

# Source de données : "demo" (fictive) ou "json" (fichiers que tu déposes)
SOURCE=demo
# SOURCE_DIR=./donnees        # obligatoire si SOURCE=json

# Port du serveur et origine autorisée pour le front (CORS)
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Synthèse rédigée par Gemini Flash (facultatif : sans clé, un texte généré sans IA est utilisé)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Stockage ---
# "sqlite" (défaut, fichier APEX_DB) ou "supabase"
STORE=sqlite
# Si STORE=supabase : tables à créer avec supabase/schema.sql (éditeur SQL de Supabase).
# La clé service_role est SECRÈTE : uniquement dans ce fichier côté back-end, jamais dans le front.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
